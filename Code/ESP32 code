// =====================================================
// COMMAND HANDLER
// =====================================================

void handleCommand(){

    if(!server.hasArg("c")){

        server.send(
            400,
            "text/plain",
            "NO COMMAND"
        );

        return;
    }


    String cmd =
        server.arg("c");


    // =================================================
    // MOTOR
    // =================================================

    if(cmd == "F"){

        Forward();
    }

    else if(cmd == "B"){

        Backward();
    }

    else if(cmd == "L"){

        Left();
    }

    else if(cmd == "R"){

        Right();
    }

    else if(cmd == "S"){

        Stop();
    }


    // =================================================
    // SPEED
    // =================================================

    else if(cmd.startsWith("V")){

        speedValue =
            cmd.substring(1).toInt();

        speedValue =
            constrain(
                speedValue,
                0,
                255
            );
    }


    // =================================================
    // SERVO
    // =================================================

    else if(cmd.startsWith("P")){

        int separator =
            cmd.indexOf('_');


        int servoNumber =
            cmd.substring(
                1,
                separator
            ).toInt();


        int angle =
            cmd.substring(
                separator + 1
            ).toInt();


        // ---------------- GRIPPER ----------------

        if(servoNumber == 1){

            gripperTarget =
                constrain(
                    angle,
                    GRIPPER_MIN,
                    GRIPPER_MAX
                );
        }


        // ---------------- ELBOW ----------------

        else if(servoNumber == 2){

            elbowTarget =
                constrain(
                    angle,
                    ELBOW_MIN,
                    ELBOW_MAX
                );
        }


        // ---------------- SHOULDER ----------------

        else if(servoNumber == 3){

            shoulderTarget =
                constrain(
                    angle,
                    SHOULDER_MIN,
                    SHOULDER_MAX
                );
        }
    }


    // =================================================
    // METAL DETECTOR
    // =================================================

    else if(cmd.startsWith("M")){

        int state =
            cmd.substring(1).toInt();

        digitalWrite(
            METAL_RELAY,
            state ? HIGH : LOW
        );
    }


    // =================================================
    // CAMERA
    // =================================================

    else if(cmd.startsWith("C")){

        int state =
            cmd.substring(1).toInt();

        digitalWrite(
            CAMERA_RELAY,
            state ? HIGH : LOW
        );
    }


    server.send(
        200,
        "text/plain",
        "OK"
    );
}


// =====================================================
// SETUP
// =====================================================

void setup(){

    Serial.begin(115200);

    delay(500);


    // =================================================
    // MOTOR
    // =================================================

    pinMode(
        LEFT_RPWM,
        OUTPUT
    );

    pinMode(
        LEFT_LPWM,
        OUTPUT
    );

    pinMode(
        RIGHT_RPWM,
        OUTPUT
    );

    pinMode(
        RIGHT_LPWM,
        OUTPUT
    );

    Stop();


    // =================================================
    // RELAY
    // =================================================

    pinMode(
        METAL_RELAY,
        OUTPUT
    );

    pinMode(
        CAMERA_RELAY,
        OUTPUT
    );


    digitalWrite(
        METAL_RELAY,
        LOW
    );

    digitalWrite(
        CAMERA_RELAY,
        LOW
    );


    // =================================================
    // SERVO
    // =================================================

    gripper.setPeriodHertz(50);
    elbow.setPeriodHertz(50);
    shoulder.setPeriodHertz(50);


    gripper.attach(
        GRIPPER_PIN,
        500,
        2400
    );


    elbow.attach(
        ELBOW_PIN,
        500,
        2400
    );


    shoulder.attach(
        SHOULDER_PIN,
        500,
        2400
    );


    // Initial positions

    gripper.write(
        GRIPPER_MIN
    );

    elbow.write(
        ELBOW_MIN
    );

    shoulder.write(
        SHOULDER_MIN
    );


    // =================================================
    // WIFI AP
    // =================================================

    WiFi.mode(
        WIFI_AP
    );


    WiFi.softAP(
        AP_SSID,
        AP_PASSWORD
    );


    // =================================================
    // WEB SERVER
    // =================================================

    server.on(
        "/",
        [](){

            server.send_P(
                200,
                "text/html",
                MAIN_page
            );

        }
    );


    server.on(
        "/cmd",
        handleCommand
    );


    server.begin();


    // =================================================
    // SERIAL
    // =================================================

    Serial.println();
    Serial.println(
        "================================"
    );

    Serial.println(
        "        MRV-46 ROBOT"
    );

    Serial.println(
        "================================"
    );

    Serial.print(
        "WiFi SSID: "
    );

    Serial.println(
        AP_SSID
    );

    Serial.print(
        "Password: "
    );

    Serial.println(
        AP_PASSWORD
    );

    Serial.print(
        "IP Address: "
    );

    Serial.println(
        WiFi.softAPIP()
    );

    Serial.println(
        "Web Server Started"
    );
}


