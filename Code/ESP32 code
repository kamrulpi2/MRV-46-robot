WebServer server(80);

// =====================================================
// BTS7960 MOTOR PINS
// =====================================================
#define LEFT_RPWM   16
#define LEFT_LPWM   17
#define RIGHT_RPWM  18
#define RIGHT_LPWM  19

// =====================================================
// SERVO PINS
// =====================================================
// Servo 2 = Gripper
// Servo 3 = Elbow
// Servo 4 = Shoulder

#define GRIPPER_PIN   26
#define ELBOW_PIN     32
#define SHOULDER_PIN  33

// =====================================================
// RELAY PINS
// =====================================================
#define METAL_RELAY   13
#define CAMERA_RELAY  14

// =====================================================
// SERVO LIMITS
// =====================================================

// Gripper
#define GRIPPER_MIN 83
#define GRIPPER_MAX 180

// Elbow
#define ELBOW_MIN 72
#define ELBOW_MAX 180

// Shoulder
#define SHOULDER_MIN 0
#define SHOULDER_MAX 130


// =====================================================
// SERVO OBJECTS
// =====================================================

Servo gripper;
Servo elbow;
Servo shoulder;


// =====================================================
// CURRENT SERVO POSITIONS
// =====================================================

int gripperAngle  = GRIPPER_MIN;
int elbowAngle    = ELBOW_MIN;
int shoulderAngle = SHOULDER_MIN;


// =====================================================
// TARGET SERVO POSITIONS
// =====================================================

int gripperTarget  = GRIPPER_MIN;
int elbowTarget    = ELBOW_MIN;
int shoulderTarget = SHOULDER_MIN;


// =====================================================
// SPEED
// =====================================================

int speedValue = 180;


// =====================================================
// MOTOR FUNCTIONS
// =====================================================

void Stop() {

  analogWrite(LEFT_RPWM, 0);
  analogWrite(LEFT_LPWM, 0);

  analogWrite(RIGHT_RPWM, 0);
  analogWrite(RIGHT_LPWM, 0);
}


void Forward() {

  analogWrite(LEFT_RPWM, speedValue);
  analogWrite(LEFT_LPWM, 0);

  analogWrite(RIGHT_RPWM, speedValue);
  analogWrite(RIGHT_LPWM, 0);
}


void Backward() {

  analogWrite(LEFT_RPWM, 0);
  analogWrite(LEFT_LPWM, speedValue);

  analogWrite(RIGHT_RPWM, 0);
  analogWrite(RIGHT_LPWM, speedValue);
}


void Left() {

  analogWrite(LEFT_RPWM, 0);
  analogWrite(LEFT_LPWM, speedValue);

  analogWrite(RIGHT_RPWM, speedValue);
  analogWrite(RIGHT_LPWM, 0);
}


void Right() {

  analogWrite(LEFT_RPWM, speedValue);
  analogWrite(LEFT_LPWM, 0);

  analogWrite(RIGHT_RPWM, 0);
  analogWrite(RIGHT_LPWM, speedValue);
}


// =====================================================
// SMOOTH SERVO SYSTEM
// =====================================================

void updateServos() {

  // ---------------- GRIPPER ----------------

  if (gripperAngle < gripperTarget) {

    gripperAngle++;

    gripper.write(gripperAngle);
  }

  else if (gripperAngle > gripperTarget) {

    gripperAngle--;

    gripper.write(gripperAngle);
  }


  // ---------------- ELBOW ----------------

  if (elbowAngle < elbowTarget) {

    elbowAngle++;

    elbow.write(elbowAngle);
  }

  else if (elbowAngle > elbowTarget) {

    elbowAngle--;

    elbow.write(elbowAngle);
  }


  // ---------------- SHOULDER ----------------

  if (shoulderAngle < shoulderTarget) {

    shoulderAngle++;

    shoulder.write(shoulderAngle);
  }

  else if (shoulderAngle > shoulderTarget) {

    shoulderAngle--;

    shoulder.write(shoulderAngle);
  }
}


